# Node 24. Copia in .env: questo file contiene solo esempi, nessuna credenziale.
NODE_ENV=development
HOST=127.0.0.1
PORT=4190
DATA_PATH=.data/scoutly.sqlite
# Chiavi diverse, generate localmente: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
RATE_LIMIT_SECRET=
ALLOWED_ORIGINS=http://127.0.0.1:4187,http://localhost:4187
ACCEPT_REQUESTS=false
CONTROLLER_NAME=Scoutly - anteprima di sviluppo
PRIVACY_URL=https://example.invalid/privacy
CONSENT_VERSION=callback-v1
CONSENT_TEXT=Chiedo di essere ricontattato dal soggetto indicato per discutere questa richiesta e confermo di aver letto l’informativa.
# 0 disabilita la cancellazione; in produzione scegliere esplicitamente una durata.
RETENTION_DAYS=0
LIVE_NOTIFICATIONS=false
ENABLE_EMAIL=false
ENABLE_TELEGRAM=false
EMAIL_FROM=
EMAIL_TO=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Per default non ci si fida degli header IP inoltrati.
TRUSTED_PROXY_IPS=
